# Safe default: no external calls and no real Gmail writes.
REPLYPILOT_MODE=mock
REPLYPILOT_CONTROL_TOKEN=replace-with-a-long-random-value
REPLYPILOT_DATABASE_PATH=.data/replypilot.sqlite3

# LLM (required only when REPLYPILOT_MODE=live)
OPENAI_API_KEY=
REPLYPILOT_OPENAI_MODEL=gpt-4.1-mini

# LangSmith tracing and evaluations
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=replypilot-local
# Privacy-first defaults: keep message and draft content out of hosted traces.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Gmail installed-app OAuth. Keep this file outside the repository.
REPLYPILOT_GOOGLE_CLIENT_SECRET_PATH=
REPLYPILOT_GOOGLE_ACCOUNT=default
